{
  "name": "becoming-bright-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Becoming Bright Studio: every day a little brighter. Short lessons that explain themselves, one skill at a time, for children aged 5 to 7. Everything stays on the family's device. Based on Kids' Learning Studio by Oluwasedago.",
  "author": "Adeolu Osiyoku (based on Kids' Learning Studio by Oluwasedago)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-brand.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-brand.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "check-private": "node scripts/check-private.mjs --all"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "lucide-react": "^1.56.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
