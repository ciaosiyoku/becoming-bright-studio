    "en": {
      "title": "The past tense",
      "teach": "To talk about yesterday, most words add -ed: today I jump, yesterday I jumped. Some words change: today I run, yesterday I ran.",
      "prompt": "Yesterday I ___ . ({now})",
      "reason": "",
      "say": "Yesterday I … what? Use the word {now}.",
      "reasons": {
        "ed": "Most words add -ed: {now} → {answer}.",
        "d": "Words ending in e just add -d: {now} → {answer}.",
        "double": "Short words like {now} double the last letter, then add -ed: {now} → {answer}.",
        "ied": "A consonant and y change to -ied: {now} → {answer}.",
        "special": "This one is special, to learn by heart: {now} → {answer}."
      }
    }
