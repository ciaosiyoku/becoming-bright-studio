      "reason": "They are linked the same way.",
      "reasons": {
        "same": "{a} means the same as {b}, and {c} means the same as {answer}.",
        "opposite": "{a} is the opposite of {b}, and {c} is the opposite of {answer}.",
        "group": "A group of {a}s is a {b}, and a group of {c}s is a {answer}."
