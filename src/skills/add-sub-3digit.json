  "text": {
    "en": {
      "title": "Adding and taking away 3-digit numbers",
      "teach": "To add, jump forward from the first number; to take away, jump back. {a} + {b}: from {a}, jump {b} → {answer}.",
      "prompt": "What is {a} {op} {b}?",
      "reason": "",
      "reasons": {
        "add": "Start at {a}, jump {b} forward → {answer}.",
        "sub": "Start at {a}, jump {b} back → {answer}."
      }
    },
    "de": {
      "title": "Dreistellige Zahlen plus und minus",
      "teach": "Beim Plusrechnen springst du von der ersten Zahl vorwärts, beim Minusrechnen zurück. {a} + {b}: von {a} {b} Sprünge vor → {answer}.",
      "prompt": "Was ist {a} {op} {b}?",
      "reason": "",
      "reasons": {
        "add": "Fang bei {a} an, spring {b} vor → {answer}.",
        "sub": "Fang bei {a} an, spring {b} zurück → {answer}."
      }
    },
    "fr": {
      "title": "Additionner et soustraire des nombres à trois chiffres",
      "teach": "Pour additionner, saute en avant depuis le premier nombre ; pour soustraire, saute en arrière. {a} + {b} : depuis {a}, {b} sauts en avant → {answer}.",
      "prompt": "Combien font {a} {op} {b} ?",
      "reason": "",
      "reasons": {
        "add": "Pars de {a}, saute {b} fois en avant → {answer}.",
        "sub": "Pars de {a}, saute {b} fois en arrière → {answer}."
      }
    },
    "yo": {
      "title": "Àròpọ̀ àti àyọkúrò nọ́ńbà oní-díjíìtì mẹ́ta",
      "teach": "Láti ṣe àròpọ̀, fò síwájú láti nọ́ńbà àkọ́kọ́; láti ṣe àyọkúrò, fò sẹ́yìn. {a} + {b}: láti {a}, fò ìgbà {b} → {answer}.",
      "prompt": "Kí ni {a} {op} {b}?",
      "reason": "",
      "reasons": {
        "add": "Bẹ̀rẹ̀ ní {a}, fò ìgbà {b} síwájú → {answer}.",
        "sub": "Bẹ̀rẹ̀ ní {a}, fò ìgbà {b} sẹ́yìn → {answer}."
      }
    }
  }
