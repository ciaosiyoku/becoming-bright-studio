  "text": {
    "en": {
      "title": "Stories with times and sharing",
      "teach": "First find what one costs, then what many cost. {a} {thing} cost {c}p, so one costs {price}p, and {b} cost {answer}p.",
      "prompt": "{a} {thing} cost {c}p. How much do {b} {thing} cost?",
      "prompts": {
        "times": "There are {a} bags with {b} {thing} in each. How many {thing} are there in all?",
        "share": "{a} {thing} are shared equally between {b} friends. How many does each friend get?",
        "unit": "{a} {thing} cost {c}p. How much do {b} {thing} cost?"
      },
      "reason": "One costs {c} ÷ {a} = {price}p, so {b} cost {b} × {price} = {answer}p.",
      "reasons": {
        "times": "{a} × {b} = {answer}.",
        "share": "{a} ÷ {b} = {answer}.",
        "unit": "One costs {c} ÷ {a} = {price}p, so {b} cost {b} × {price} = {answer}p."
      }
    }
  }
