    "en": {
      "title": "Word pairs",
      "teach": "Say how the first pair goes together, then find a word that goes with the third the same way. A {b} is a young {a}, so a young {c} is a {answer}.",
      "prompt": "{a} is to {b} as {c} is to …?",
      "reason": "They go together the same way.",
      "reasons": {
        "young": "A young {a} is a {b}, and a young {c} is a {answer}.",
        "home": "A {a} lives in a {b}, and a {c} lives in a {answer}.",
        "opposite": "{a} and {b} are opposites, so the opposite of {c} is {answer}."
      }
